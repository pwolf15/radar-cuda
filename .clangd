CompileFlags:
  CompilationDatabase: build
  Add:
    - --cuda-path=/usr/local/cuda
    - --cuda-gpu-arch=sm_86
    - --gcc-toolchain=/usr
    - -stdlib=libstdc++
    - -I/usr/local/cuda/include
    - -DPy_LIMITED_API=0
    - -DPYBIND11_CPP17
  Remove:
    - -forward-unknown-to-host-compiler
    - --generate-code*
    - -Xcompiler*
    - --expt-*
    - -rdc=*
