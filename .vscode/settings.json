{
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    "--compile-commands-dir=build",
    "--background-index",
    "--header-insertion=never"
  ],
  "cmake.configureOnOpen": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "files.associations": {
    "*.cu": "cuda-cpp",
    "*.cuh": "cuda-cpp"
  }
}
